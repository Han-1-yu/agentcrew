# ─────────────────────────────────────────────────────────────────────────────
# AgentCrew 环境变量样例
#
# 用法：cp .env.example .env，按注释填值。优先级（后者覆盖前者）：
#   代码默认 → .env → agentcrew.yaml → 真实环境变量 AGENTCREW_*
#
# 两条红线：
#   1) 生产环境必须配 AGENTCREW_API_KEYS。认证默认开启且 fail-closed——既没配
#      key 又没显式关闭认证时，`serve` 绑非回环地址会直接拒绝启动。
#   2) 不要把本文件改成真实密钥后提交；.gitignore 已忽略 .env。
#
# 注意：本文件**不使用行内注释**（`KEY=value  # 说明`）。dotenv 会把注释
# 连同值一起读进来，导致 key 变成一段中文——这是照抄样例最常踩的坑。
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# 1. 模型 Provider API Key（至少配一个；--mock 模式全都不需要）
# ══════════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# 豆包 / 火山方舟
ARK_API_KEY=
# 通义千问
DASHSCOPE_API_KEY=
# 文心一言（千帆 v2）
QIANFAN_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1

# ══════════════════════════════════════════════════════════════════════════════
# 2. 模型绑定（格式 <provider>:<model>）
# ══════════════════════════════════════════════════════════════════════════════
AGENTCREW_DEFAULT_MODEL=openai:gpt-4o-mini

# 按角色覆盖（可选；留空继承默认）
AGENTCREW_MODEL_PROJECT_MANAGER=
AGENTCREW_MODEL_PRODUCT_MANAGER=
AGENTCREW_MODEL_ARCHITECT=
AGENTCREW_MODEL_BACKEND_DEV=
AGENTCREW_MODEL_FRONTEND_DEV=
AGENTCREW_MODEL_QA_ENGINEER=
AGENTCREW_MODEL_DEVOPS_ENGINEER=
AGENTCREW_MODEL_TECHNICAL_WRITER=

# 按复杂度自动选模型（可选；留空则全部用默认模型）
AGENTCREW_TIER_LOW=
AGENTCREW_TIER_MEDIUM=
AGENTCREW_TIER_HIGH=

# ══════════════════════════════════════════════════════════════════════════════
# 3. 运行时
# ══════════════════════════════════════════════════════════════════════════════
AGENTCREW_MAX_CONCURRENCY=4
AGENTCREW_OUTPUT_DIR=output
# both | plan | delivery | none
AGENTCREW_GATE=both
AGENTCREW_CONTEXT_BUDGET=24000
AGENTCREW_LOG_LEVEL=INFO
AGENTCREW_MOCK=false
AGENTCREW_MOCK_LATENCY_MS=0
AGENTCREW_STREAM=true

# ══════════════════════════════════════════════════════════════════════════════
# 4. 【生产必配】HTTP API 认证
# ══════════════════════════════════════════════════════════════════════════════
# 生成随机串：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 多密钥/RBAC（角色、作用域、过期、吊销）：python main.py keys add --role operator
AGENTCREW_API_AUTH_ENABLED=true
AGENTCREW_API_KEYS=

# ══════════════════════════════════════════════════════════════════════════════
# 5. 【生产建议】限流与反向代理
# ══════════════════════════════════════════════════════════════════════════════
AGENTCREW_API_RATE_LIMIT_ENABLED=true
# 每窗口允许的请求数
AGENTCREW_API_RATE_LIMIT_MAX=120
# 窗口秒数
AGENTCREW_API_RATE_LIMIT_WINDOW=60
# 默认**不信任** X-Forwarded-For（防伪造绕过限流/审计）。仅当部署在反向代理
# 之后、且代理会重写该头时才填代理 IP/CIDR（逗号分隔），例如
# 10.0.0.0/8,127.0.0.1
AGENTCREW_TRUSTED_PROXIES=

# ══════════════════════════════════════════════════════════════════════════════
# 6. 【生产必配】成本与调用预算
# ══════════════════════════════════════════════════════════════════════════════
# 留空 = 不限制。一次多 Agent run 可能烧掉几十美元，生产务必设上限。
AGENTCREW_MAX_COST_USD=
AGENTCREW_MAX_LLM_CALLS=
# 单次 LLM 请求超时（秒）；默认 120
AGENTCREW_LLM_REQUEST_TIMEOUT_SECONDS=120

# ══════════════════════════════════════════════════════════════════════════════
# 7. 【生产建议】日志脱敏与可观测性
# ══════════════════════════════════════════════════════════════════════════════
AGENTCREW_REDACT_ENABLED=true
AGENTCREW_REDACT_API_KEYS=true
AGENTCREW_REDACT_PII=true
AGENTCREW_REDACT_CREDENTIALS=true

# OpenTelemetry（可选；关闭时只落本地 ledger / trace 文件）
AGENTCREW_OTEL_ENABLED=false
# 例如 http://localhost:4318/v1/traces
AGENTCREW_OTEL_ENDPOINT=
AGENTCREW_OTEL_SERVICE_NAME=agentcrew
# 是否把提示词/模型输出写进 span（含业务敏感内容，生产建议 false）
AGENTCREW_OTEL_CAPTURE_CONTENT=false

# ══════════════════════════════════════════════════════════════════════════════
# 8. 人工审批与工具执行（安全相关）
# ══════════════════════════════════════════════════════════════════════════════
# 空 = 跟随 gate；可选 plan | delivery | both | none
AGENTCREW_APPROVAL_MODE=
# 0 = 不超时；>0 到期自动判 expired
AGENTCREW_APPROVAL_TIMEOUT_SECONDS=0
AGENTCREW_TOOLS_ENABLED=true
# 允许模型在沙箱内执行代码。生产若不需要，显式关掉以缩小攻击面。
AGENTCREW_CODE_EXEC_ENABLED=false
# 输入来自外部/不可信来源时置 true：提示词会带防御性说明
AGENTCREW_UNTRUSTED_INPUTS=false

# ══════════════════════════════════════════════════════════════════════════════
# 9. 本地开发覆盖（仅 dev；生产不要开）
# ══════════════════════════════════════════════════════════════════════════════
# AGENTCREW_MOCK=true
# AGENTCREW_GATE=none
# AGENTCREW_DEBUG_STEP=true
# AGENTCREW_LOG_LEVEL=DEBUG
