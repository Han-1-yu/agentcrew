# AgentCrew 回环 TLS 反代示例（VM 实测同源配置）。
# 生产有域名时改为 listen 443 ssl + 正式证书；本示例 18443 适用于无特权端口环境。
worker_processes 1;
pid /run/agentcrew-nginx.pid;
error_log /var/log/agentcrew/nginx-error.log notice;

events {
    worker_connections 128;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /var/log/agentcrew/nginx-access.log;
    sendfile on;

    server {
        listen 127.0.0.1:18443 ssl;
        server_name localhost;

        ssl_certificate /etc/agentcrew/tls/server.crt;
        ssl_certificate_key /etc/agentcrew/tls/server.key;
        ssl_protocols TLSv1.2 TLSv1.3;

        location / {
            proxy_pass http://127.0.0.1:8765;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Connection "";

            # SSE 必须禁用缓冲；读超时大于应用心跳周期。
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
            add_header X-Accel-Buffering no;
        }
    }
}
